<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cine_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/textQuestionnaireTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/questionario_title"
            android:textAppearance="@style/TextAppearance.CinePersona.Titulo" />

        <TextView
            android:id="@+id/textGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/cine_text_secondary"
            android:textSize="16sp" />

        <androidx.cardview.widget.CardView
            style="@style/Widget.CinePersona.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/questionario_momento_label"
                    android:textAppearance="@style/TextAppearance.CinePersona.Rotulo" />

                <RadioGroup
                    android:id="@+id/groupMomento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioMomento0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cine_green"
                        android:paddingStart="8dp"
                        android:minHeight="48dp"
                        android:text="@string/questionario_momento_roteiro"
                        android:textColor="@color/cine_text"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/radioMomento1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cine_green"
                        android:paddingStart="8dp"
                        android:minHeight="48dp"
                        android:text="@string/questionario_momento_afetivo"
                        android:textColor="@color/cine_text"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/radioMomento2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cine_green"
                        android:paddingStart="8dp"
                        android:minHeight="48dp"
                        android:text="@string/questionario_momento_adrenalina"
                        android:textColor="@color/cine_text"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/radioMomento3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cine_green"
                        android:paddingStart="8dp"
                        android:minHeight="48dp"
                        android:text="@string/questionario_momento_fora_de_quadro"
                        android:textColor="@color/cine_text"
                        android:textSize="15sp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            style="@style/Widget.CinePersona.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/questionario_clima_label"
                    android:textAppearance="@style/TextAppearance.CinePersona.Rotulo" />

                <Spinner
                    android:id="@+id/spinnerClima"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:entries="@array/questionario_climas"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            style="@style/Widget.CinePersona.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/questionario_prioridades_label"
                    android:textAppearance="@style/TextAppearance.CinePersona.Rotulo" />

                <CheckBox
                    android:id="@+id/checkPrioridade0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:buttonTint="@color/cine_green"
                    android:paddingStart="8dp"
                    android:minHeight="48dp"
                    android:text="@string/questionario_prioridade_roteiro"
                    android:textColor="@color/cine_text"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/checkPrioridade1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/cine_green"
                    android:paddingStart="8dp"
                    android:minHeight="48dp"
                    android:text="@string/questionario_prioridade_afetivo"
                    android:textColor="@color/cine_text"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/checkPrioridade2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/cine_green"
                    android:paddingStart="8dp"
                    android:minHeight="48dp"
                    android:text="@string/questionario_prioridade_adrenalina"
                    android:textColor="@color/cine_text"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/checkPrioridade3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/cine_green"
                    android:paddingStart="8dp"
                    android:minHeight="48dp"
                    android:text="@string/questionario_prioridade_fora_de_quadro"
                    android:textColor="@color/cine_text"
                    android:textSize="15sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            style="@style/Widget.CinePersona.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchLadoB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:text="@string/questionario_lado_b"
                android:textColor="@color/cine_text"
                android:textSize="15sp"
                app:thumbTint="@color/switch_thumb" />
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/buttonRecomendar"
            style="@style/Widget.CinePersona.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:enabled="false"
            android:text="@string/questionario_enviar" />

        <ProgressBar
            android:id="@+id/progressQuestionario"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
