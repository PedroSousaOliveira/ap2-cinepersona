<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cine_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <ImageView
            android:id="@+id/imageLogo"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:contentDescription="@string/login_logo_description"
            android:src="@drawable/ic_cinepersona_logo" />

        <TextView
            android:id="@+id/textLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/login_title"
            android:textColor="@color/cine_text"
            android:textSize="24sp" />

        <EditText
            android:id="@+id/editNome"
            style="@style/Widget.CinePersona.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:autofillHints="name"
            android:hint="@string/login_name_hint"
            android:inputType="textPersonName"
            android:singleLine="true" />

        <EditText
            android:id="@+id/editEmail"
            style="@style/Widget.CinePersona.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="emailAddress"
            android:hint="@string/login_email_hint"
            android:inputType="textEmailAddress"
            android:singleLine="true" />

        <Button
            android:id="@+id/buttonEntrar"
            style="@style/Widget.CinePersona.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/login_continue" />

        <ProgressBar
            android:id="@+id/progressLogin"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
